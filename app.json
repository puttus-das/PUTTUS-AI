{
  "name": "PUTTUS-AI",
  "description": "WhatsApp automation bot with Telegram pairing",
  "keywords": [
    "whatsapp",
    "bot",
    "baileys",
    "telegram"
  ],
  "repository": "https://github.com/puttus-das/PUTTUS-AI",
  "env": {
    "TELEGRAM_BOT_TOKEN": {
      "description": "Telegram bot token from BotFather",
      "required": true
    },
    "REMOVEBG_KEY": {
      "description": "Optional Remove.bg API key",
      "required": false
    },
    "MONGO_URL": {
      "description": "Optional MongoDB connection URL",
      "required": false
    },
    "MYSQL_URL": {
      "description": "Optional MySQL connection URL",
      "required": false
    },
    "POSTGRES_URL": {
      "description": "Optional PostgreSQL connection URL",
      "required": false
    }
  },
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    },
    {
      "url": "https://github.com/DuckyTeam/heroku-buildpack-imagemagick.git"
    },
    {
      "url": "https://github.com/jonathanong/heroku-buildpack-ffmpeg-latest"
    },
    {
      "url": "https://github.com/clhuang/heroku-buildpack-webp-binaries.git"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
